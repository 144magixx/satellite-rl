  "evaluation": {
    "validation_count": 20,
    "test_count": 100,
    "validation_seed": 274000,
    "test_seed": 275000,
    "interval_steps": 10000,
    "action_mode": "stochastic",
    "repeats": 3,
    "extra_steps": [
      0,
