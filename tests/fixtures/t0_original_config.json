    "power_levels_w": [
      5,
      10,
      15,
      20,
      25,
      30,
      35,
      40,
      45,
      50
    ]
  },
  "training": {
    "seed": 51001,
    "scene_order": "shuffle_each_cycle",
    "scene_order_seed": 51001,
    "total_steps": 150000,
    "batch_size": 256,
    "actor_lr": 1e-05,
